            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\r\n# Update and install Node.js and Git [cite: 42, 44]\r\ndnf update -y\r\ndnf install -y nodejs git\r\n\r\n# Setup application directory\r\nmkdir -p /home/ec2-user/app\r\ncd /home/ec2-user/app\r\n\r\n# Initialize and install Express\r\nnpm init -y\r\nnpm install express\r\n\r\n# Create the API script [cite: 48-54]\r\ncat \u003c\u003cJS \u003e index.js\r\nconst express = require('express');\r\nconst app = express();\r\nconst port = 3000;\r\n\r\napp.get('/', (req, res) =\u003e {\r\n  res.send('Hello from Assignment 2');\r\n});\r\n\r\napp.get('/info', (req, res) =\u003e {\r\n  res.json({\r\n    name: \"Bo Zhang\",\r\n    student_id: \"8857286\",\r\n    course: \"INFO8372-Cloud Fundamentals for Develpers\"\r\n  });\r\n});\r\n\r\napp.listen(port, () =\u003e {\r\n  console.log('App running on port ' + port);\r\n});\r\nJS\r\n\r\n# Run the application automatically [cite: 57-58]\r\nnohup node index.js \u003e app.log 2\u003e\u00261 \u0026\r\n",
